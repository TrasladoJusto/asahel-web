# Environment variables for local development
# Copy to .env.local and fill in your values

# Resend API Key for contact form emails
RESEND_API_KEY=re_your_key_here

# Contact email where form submissions are sent
CONTACT_EMAIL=hola@asahel.dev

# Site URL for canonical URLs and OG images
# NOTA: variable server-only (sin prefijo NEXT_PUBLIC_) — nunca se expone al navegador
SITE_URL=https://asahel.pages.dev